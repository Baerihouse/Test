.claude/settings.local.json

# Dependencies / build output
node_modules/
dist/
build/
.vite/
.wrangler/
.turbo/
coverage/
.react-router/

# Local environment files. Keep examples tracked.
.env
.env.*
!.env.example
!.env.*.example

# 교육 원본 자료 (자체 git 저장소, 로컬 참고용)
llm-wiki/

# OS / editor
.DS_Store
Thumbs.db
*.log

# 저장소 루트를 Obsidian 볼트로 연 흔적(기계별 설정). 위키 볼트는 wiki/ 이고
# wiki/.obsidian/graph.json 은 그래프 뷰 설정이라 추적한다.
/.obsidian/

# 에이전트 도구가 기계·세션별로 만드는 로컬 산출물. 공유할 내용이 없어 추적하지 않는다.
# graft: 코드 그래프 캐시 (`graft build`로 재생성). `.ignore`는 이 캐시를 ripgrep에만 다시 열어주는 설정.
/graft/
/.ignore

# omc(oh-my-claudecode): state/·logs/·plans/·reports/·specs/·artifacts/·wiki/ 등 세션 산출물 전부.
# 디렉터리가 아니라 내용물을 무시해서, 나중에 공유할 파일이 생기면 `!.omc/<파일>`로 되살릴 수 있다.
.omc/*

# Claude Code가 만드는 로컬 워크트리. `.git/info/exclude`에만 있어 클론에는 전달되지 않았다.
.claude/worktrees/

# Cloudflare 로컬 비밀값. 실제 값 없는 예시 파일은 공유한다.
.dev.vars
.dev.vars.*
!.dev.vars.example
!.dev.vars.*.example

# 개인키와 인증서 저장소. 공개 인증서(.crt/.cer)는 제외하지 않는다.
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_ed25519

# 저장소 안에 실수로 복사한 로컬 인증정보
.aws/
.ssh/
.azure/
.config/gcloud/
.codex/auth.json
.codex/sessions/
.codex/log/
.codex/history.jsonl
.npmrc.local

# 추가 패키지 캐시 / 배포 도구의 로컬 상태
.pnpm-store/
.npm/
.cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
.vercel/
.netlify/
supabase/.temp/
supabase/.branches/

# 브라우저 테스트 결과와 로그인 상태
playwright-report/
test-results/
blob-report/
playwright/.auth/

# 편집기 개인 설정. 팀에서 공유하는 VS Code 설정은 허용한다.
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.code-workspace
*.swp
*.swo
*~

# 임시 파일 / Windows·Office 잠금 파일
*.tmp
*.temp
~$*
Desktop.ini
$RECYCLE.BIN/
